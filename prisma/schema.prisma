generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id       String   @id @default(cuid())
  slug     String   @unique
  category String
  date     DateTime
  summary  String
  title    String
  tags     Tags[]

  @@index([category, date])
  @@index([slug])
}

model Tags {
  id       String @id @default(cuid())
  name     String @db.VarChar(30)
  postSlug String
  post     Post   @relation(fields: [postSlug], references: [slug])
}

model Redirects {
  id          String   @id @default(cuid())
  source      String
  destination String
  createdAt   DateTime @default(now())

  @@unique([source, destination])
  @@index([source])
}

model Pattern {
  pattern  String[]
  length   Int
  username String   @unique
  id       Int      @id @default(autoincrement())
  UserInfo UserInfo @relation(fields: [username], references: [username])
}

model PinHash {
  username String   @unique
  hash     Json
  id       Int      @id @default(autoincrement())
  UserInfo UserInfo @relation(fields: [username], references: [username])
}

model PinNumbers {
  numbers  String[]
  username String   @unique
  id       Int      @id @default(autoincrement())
  UserInfo UserInfo @relation(fields: [username], references: [username])
}

model UserInfo {
  id         String      @id
  username   String      @unique
  session_id String?     @unique
  Pattern    Pattern?
  PinHash    PinHash?
  PinNumbers PinNumbers?
}

model account_types {
  code String  @id @db.VarChar(20)
  name String  @db.VarChar(50)
  note String?
}

model accounts {
  account_number BigInt         @id @unique(map: "unique_account_number")
  user_id        Int
  account_type   String         @default("CHECKING") @db.VarChar(20)
  balance        Decimal        @default(0) @db.Decimal(15, 2)
  created_at     DateTime       @default(now()) @db.Timestamp(6)
  users          users          @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  transactions   transactions[]
}

model auth_methods {
  auth_method_id Int      @id @default(autoincrement())
  user_id        Int
  method         String   @db.VarChar(50)
  credential     String   @db.VarChar(255)
  provider       String?  @db.VarChar(50)
  provider_uid   String?  @db.VarChar(100)
  created_at     DateTime @default(now()) @db.Timestamp(6)
  users          users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model transaction_types {
  code String  @id @db.VarChar(20)
  name String  @db.VarChar(50)
  note String?
}

model transactions {
  transaction_id   BigInt   @id @default(autoincrement())
  account_number   BigInt
  amount           Decimal  @db.Decimal(15, 2)
  transaction_type String   @db.VarChar(20)
  description      String?
  occurred_at      DateTime @default(now()) @db.Timestamp(6)
  accounts         accounts @relation(fields: [account_number], references: [account_number], onDelete: Cascade, onUpdate: NoAction)

  @@index([account_number], map: "idx_transactions_account")
}

model users {
  user_id      Int            @id @default(autoincrement())
  name         String         @db.VarChar(100)
  created_at   DateTime       @default(now()) @db.Timestamp(6)
  accounts     accounts[]
  auth_methods auth_methods[]
}
