generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Post {
  id   String @id @default(cuid())
  slug String @unique
  tags Tags[]

  @@index([slug])
}

model Tags {
  id       String @id @default(cuid())
  name     String
  post     Post   @relation(fields: [postSlug], references: [slug])
  postSlug String
}

model PostImages {
  id          String  @id @default(cuid())
  imageId     String  @unique
  altText     String?
  contentType String
  blob        Bytes
}

model Redirects {
  id          String   @id @default(cuid())
  source      String
  destination String
  createdAt   DateTime @default(now())

  @@index([source])
  @@unique([source, destination])
}
