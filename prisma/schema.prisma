generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Post {
  id       String   @id @default(cuid())
  slug     String   @unique
  category String
  title    String
  summary  String
  date     DateTime
  tags     Tags[]

  @@index([category, date])
  @@index([slug])
}

model Tags {
  id       String @id @default(cuid())
  name     String @db.VarChar(30)
  post     Post   @relation(fields: [postSlug], references: [slug])
  postSlug String
}

model Redirects {
  id          String   @id @default(cuid())
  source      String
  destination String
  createdAt   DateTime @default(now())

  @@unique([source, destination])
  @@index([source])
}

model Pattern {
  id       String   @id
  pattern  String[]
  length   Int
  username String   @unique
  UserInfo UserInfo @relation(fields: [username], references: [username])
}

model PinHash {
  id       String   @id
  username String   @unique
  hash     Json
  UserInfo UserInfo @relation(fields: [username], references: [username])
}

model PinNumbers {
  id       String
  numbers  String[]
  username String   @unique
  UserInfo UserInfo @relation(fields: [username], references: [username])
}

model UserInfo {
  id         String
  username   String      @unique
  Pattern    Pattern?
  PinHash    PinHash?
  PinNumbers PinNumbers?
}
