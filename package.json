{
	"name": "sunub.github.io",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev:f": "pnpm --filter frontend run dev",
		"dev:d": "pnpm --filter backend run dev",
		"build": "pnpm --filter fx_utils run build && pnpm --filter frontend run build",
		"build:f": "pnpm --filter frontend run build",
		"format:check": "pnpm dlx prettier --check .",
		"lint": "pnpm exec biome lint",
		"lint:frontend": "pnpm exec biome lint frontend",
		"lint:backend": "eslint backend/ --ext .js,.ts",
		"lint:utils": "pnpm exec biome lint ./fx_utils",
		"lint:write": "pnpm exec biome check --write --unsafe",
		"format": "pnpm exec biome format --write",
		"build:utils": "pnpm --filter fx_utils run build",
		"bench:stress": "node ./test/runBench.mjs",
		"bench": "vitest bench",
		"test": "pnpm --filter frontend run test",
		"test:e2e": "pnpm --filter frontend run test:e2e",
		"test:e2e:ui": "pnpm --filter frontend run test:e2e:ui",
		"test:e2e:stress": "pnpm --filter frontend run test:e2e:stress",
		"dev:prepare": "pnpm build:utils",
		"postinstall": "pnpm build:utils",
		"start:frontend": "pnpm --filter frontend run start"
	},
	"dependencies": {
		"@nestjs/mapped-types": "*",
		"@types/node": "^24.1.0",
		"execa": "^9.6.0",
		"ora": "^8.2.0",
		"typescript": "^5.8.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.6",
		"globals": "^16.3.0"
	},
	"resolutions": {
		"postcss-selector-parser": "^6.0.10"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@swc/core",
			"@vercel/speed-insights",
			"bufferutil",
			"esbuild",
			"sharp",
			"unrs-resolver",
			"utf-8-validate"
		]
	},
	"packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c"
}
