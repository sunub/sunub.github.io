{
  "name": "sunub.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:f": "pnpm --filter frontend run dev",
    "dev:d": "pnpm --filter backend run dev",
    "build": "pnpm --filter fx_utils run build && pnpm --filter frontend run build",
    "build:f": "pnpm --filter frontend run build",
    "build:utils": "pnpm --filter fx_utils run build",
    "bench:stress": "node ./test/runBench.mjs",
    "bench": "vitest bench",
    "test": "vitest --exclude \"**/*.bench.ts\""
  },
  "dependencies": {
    "@types/node": "^24.1.0",
    "execa": "^9.6.0",
    "ora": "^8.2.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.31.0",
    "@next/eslint-plugin-next": "^15.4.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "eslint": "^9.31.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "typescript-eslint": "^8.37.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
