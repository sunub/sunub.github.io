{
	"name": "frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev --turbo",
		"build:dev": "next build",
		"build": "concurrently --kill-others --success first \"wait-on tcp:4008 && next build\" \"pnpm --filter backend run start:ci\"",
		"build:e2e": "next build",
		"build:workers": "tsc -p tsconfig.worker.json",
		"start": "next start -p 4004",
		"start:e2e:app": "cross-env PORT=4004 next start",
		"start:e2e": "concurrently --kill-others --success first \"pnpm --filter backend run start:ci\" \"wait-on tcp:4008 && pnpm run start:e2e:app\"",
		"start:test": "pnpm run build:e2e && pnpm run start:e2e",
		"lint": "pnpm exec biome lint",
		"check": "pnpm exec biome check --write",
		"analyze": "cross-env ANALYZE=true next build --webpack && xdg-open .next/analyze/client.html",
		"analyze:client": "cross-env ANALYZE=true next build --webpack && xdg-open .next/analyze/client.html",
		"analyze:server": "cross-env ANALYZE=true next build --webpack && xdg-open .next/analyze/nodejs.html",
		"analyze:edge": "cross-env ANALYZE=true next build --webpack && xdg-open .next/analyze/edge.html",
		"test": "vitest run --exclude \"**/*.bench.ts\" && playwright test",
		"test:e2e": "playwright test",
		"test:e2e:ci": "pnpm run build:e2e && playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:stress": "playwright test --repeat-each=5 --workers=5 -x",
		"test:e2e:search": "playwright test Search.test.tsx",
		"test:e2e:app": "playwright test App.test.tsx",
		"test:e2e:scroll-metrics": "playwright test App.test.tsx -g \"스크롤\" --project=chromium",
		"test:e2e:scroll-metrics:repeat": "playwright test App.test.tsx -g \"스크롤\" --project=chromium",
		"test:e2e:scroll-metrics:matrix": "playwright test App.test.tsx -g \"스크롤\" --project=chromium",
		"test:e2e:scroll-metrics:deep": "playwright test App.test.tsx -g \"스크롤\" --project=chromium",
		"test:e2e:scroll-metrics:deep:baseline-compare": "playwright test App.test.tsx -g \"스크롤\" --project=chromium",
		"test:e2e:scroll-metrics:baseline-compare": "playwright test App.test.tsx -g \"스크롤\" --project=chromium",
		"metrics:blog-scroll": "node scripts/aggregate-blog-scroll-metrics.mjs",
		"test:e2e:scroll:perf": "playwright test test/e2e/BlogPostInfiniteScrollPerf.test.ts --project=chromium",
		"test:unit": "vitest --exclude \"**/*.bench.ts\"",
		"test:unit:watch": "vitest unit watch --exclude \"**/*.bench.ts\""
	},
	"browserslist": [
		"last 2 chrome version",
		"last 2 firefox version",
		"last 2 safari version",
		"last 2 edge version"
	],
	"dependencies": {
		"@sunub/contracts": "workspace:*",
		"@sunub/types": "workspace:*",
		"@mdx-js/loader": "^3.1.0",
		"@mdx-js/react": "^3.1.0",
		"@next/mdx": "^15.4.1",
		"@radix-ui/react-slot": "^1.1.2",
		"cross-env": "^7.0.3",
		"execa": "^9.6.0",
		"gray-matter": "^4.0.3",
		"jotai": "^2.13.1",
		"js-cookie": "^3.0.5",
		"lodash.throttle": "^4.1.1",
		"lucide-react": "^0.555.0",
		"motion": "^12.23.24",
		"next": "16.0.7",
		"next-mdx-remote": "^5.0.0",
		"ora": "^8.0.1",
		"react": "^19.2.1",
		"react-dom": "^19.2.1",
		"react-focus-lock": "^2.9.6",
		"react-intersection-observer": "^9.14.1",
		"react-remove-scroll": "^2.5.7",
		"sharp": "^0.32.6",
		"styled-components": "^6.1.19",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@next/bundle-analyzer": "^16.0.5",
		"@playwright/test": "^1.57.0",
		"@testing-library/jest-dom": "^6.1.3",
		"@testing-library/react": "^14.3.1",
		"@types/js-cookie": "^3.0.6",
		"@types/lodash.throttle": "^4.1.9",
		"@types/node": "^20.3.1",
		"@types/react": "19.0.0",
		"@types/react-dom": "19.0.0",
		"@types/styled-components": "^5.1.36",
		"@vitejs/plugin-react": "^5.0.0",
		"@vitest/browser": "^3.2.4",
		"autoprefixer": "^10.4.22",
		"baseline-browser-mapping": "^2.10.0",
		"@sunub/utils": "workspace:*",
		"jsdom": "^27.2.0",
		"shiki": "^3.15.0",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^3.2.4"
	}
}
