{
	"name": "frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev --turbo",
		"build:dev": "node ./scripts/run-next-build.mjs",
		"build": "concurrently --kill-others --success first \"wait-on tcp:4008 && node ./scripts/run-next-build.mjs\" \"pnpm --filter backend run start:ci\"",
		"build:workers": "tsc -p tsconfig.worker.json",
		"start": "next start -p 4004",
		"start:test": "cross-env PORT=4004 next start",
		"lint": "pnpm exec biome lint",
		"check": "pnpm exec biome check --write",
		"analyze": "cross-env ANALYZE=true node ./scripts/run-next-build.mjs --webpack && xdg-open .next/analyze/client.html",
		"analyze:client": "cross-env ANALYZE=true node ./scripts/run-next-build.mjs --webpack && xdg-open .next/analyze/client.html",
		"analyze:server": "cross-env ANALYZE=true node ./scripts/run-next-build.mjs --webpack && xdg-open .next/analyze/nodejs.html",
		"analyze:edge": "cross-env ANALYZE=true node ./scripts/run-next-build.mjs --webpack && xdg-open .next/analyze/edge.html",
		"test": "vitest run --exclude \"**/*.bench.ts\" && playwright test",
		"test:unit": "vitest --exclude \"**/*.bench.ts\"",
		"test:unit:watch": "vitest unit watch --exclude \"**/*.bench.ts\"",
		"start:be": "pnpm --filter backend run start",
		"start:fe": "pnpm --filter frontend run start:test",
		"start:all": "pnpm run build && concurrently \"pnpm run start:fe\" \"pnpm run start:be\"",
		"test:pw": "playwright test",
		"test:e2e": "start-server-and-test start:all http-get://localhost:4004 \"cross-env PLAYWRIGHT_SKIP_WEB_SERVER=1 pnpm run test:pw\""
	},
	"browserslist": [
		"last 2 chrome version",
		"last 2 firefox version",
		"last 2 safari version",
		"last 2 edge version"
	],
	"dependencies": {
		"@mdx-js/loader": "^3.1.0",
		"@mdx-js/react": "^3.1.0",
		"@next/mdx": "16.0.7",
		"@radix-ui/react-slot": "^1.1.2",
		"@sunub/contracts": "workspace:*",
		"@sunub/types": "workspace:*",
		"cross-env": "^7.0.3",
		"execa": "^9.6.0",
		"gray-matter": "^4.0.3",
		"jotai": "^2.13.1",
		"js-cookie": "^3.0.5",
		"katex": "^0.16.38",
		"lodash.throttle": "^4.1.1",
		"lucide-react": "^0.555.0",
		"motion": "^12.23.24",
		"next": "16.0.7",
		"next-mdx-remote": "^5.0.0",
		"ora": "^8.0.1",
		"react": "^19.2.1",
		"react-dom": "^19.2.1",
		"react-focus-lock": "^2.9.6",
		"react-intersection-observer": "^9.14.1",
		"react-remove-scroll": "^2.5.7",
		"rehype-katex": "^7.0.1",
		"remark-math": "^6.0.0",
		"sharp": "^0.32.6",
		"styled-components": "^6.1.19",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@next/bundle-analyzer": "^16.0.5",
		"@playwright/test": "^1.57.0",
		"@sunub/utils": "workspace:*",
		"@testing-library/jest-dom": "^6.1.3",
		"@testing-library/react": "^14.3.1",
		"@types/js-cookie": "^3.0.6",
		"@types/lodash.throttle": "^4.1.9",
		"@types/node": "^20.3.1",
		"@types/react": "19.0.0",
		"@types/react-dom": "19.0.0",
		"@types/styled-components": "^5.1.36",
		"@vitejs/plugin-react": "^5.0.0",
		"@vitest/browser": "^3.2.4",
		"add": "^2.0.6",
		"autoprefixer": "^10.4.22",
		"baseline-browser-mapping": "2.10.7",
		"jsdom": "^27.2.0",
		"shiki": "^3.15.0",
		"start-server-and-test": "^2.1.5",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^3.2.4"
	}
}
