{
	"name": "frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "concurrently \"pnpm --filter backend run start:dev\" \"next dev --turbo\"",
		"prebuild": "cd .. && pnpm --filter fx_utils run build",
		"build": "concurrently --kill-others --success first \"wait-on tcp:4008 && cross-env EC2_PUBLIC_API_URL=http://localhost:4008 next build\" \"pnpm --filter backend run start:ci\"",
		"build:workers": "tsc -p tsconfig.worker.json",
		"start": "pnpm run build && next start -p 4004",
		"start:test": "pnpm --filter frontend run build && concurrently -k \"pnpm --filter backend run start\" \"wait-on tcp:4008 && next start -p 4004\"",
		"lint": "pnpm exec biome lint",
		"analyze": "cross-env ANALYZE=true npm run build",
		"test": "vitest run --exclude \"**/*.bench.ts\" && playwright test",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:stress": "playwright test --repeat-each=5 --workers=5 -x",
		"test:e2e:search": "playwright test Search.test.tsx",
		"test:e2e:app": "playwright test App.test.tsx",
		"test:unit": "vitest --exclude \"**/*.bench.ts\"",
		"test:unit:watch": "vitest unit watch --exclude \"**/*.bench.ts\""
	},
	"dependencies": {
		"@mdx-js/loader": "^3.1.0",
		"@mdx-js/react": "^3.1.0",
		"@next/bundle-analyzer": "^13.5.8",
		"@next/mdx": "^15.0.4",
		"@radix-ui/react-slot": "^1.1.2",
		"@types/jest": "^29.5.5",
		"@types/marked": "^5.0.0",
		"@types/mdx": "^2.0.13",
		"@vercel/analytics": "^1.1.0",
		"@vercel/postgres": "^0.7.2",
		"@vercel/speed-insights": "^1.0.10",
		"chalk": "^5.3.0",
		"chokidar": "^4.0.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cross-env": "^7.0.3",
		"date-fns": "^3.3.1",
		"dotenv": "^16.4.1",
		"gray-matter": "^4.0.3",
		"gsap": "^3.12.5",
		"inquirer": "^12.0.1",
		"jotai": "^2.13.1",
		"js-cookie": "^3.0.5",
		"lodash.throttle": "^4.1.1",
		"lucide-react": "^0.477.0",
		"marked": "^5.1.0",
		"motion": "^12.23.24",
		"next": "^15.0.4",
		"next-mdx-remote": "^5.0.0",
		"ora": "^8.0.1",
		"postcss-preset-env": "^9.3.0",
		"postcss-selector-parser": "^7.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-error-boundary": "^5.0.0",
		"react-focus-lock": "^2.9.6",
		"react-intersection-observer": "^9.14.1",
		"react-markdown": "^9.0.1",
		"react-remove-scroll": "^2.5.7",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.0",
		"remark-slug": "^7.0.1",
		"sharp": "^0.32.6",
		"styled-components": "^5.3.11",
		"swr": "^2.2.4",
		"ts-node": "^10.9.1",
		"tsx": "^4.20.3",
		"unified": "^11.0.4",
		"vercel": "latest",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@playwright/test": "^1.54.2",
		"@swc/cli": "^0.1.62",
		"@swc/core": "^1.3.92",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.1.3",
		"@testing-library/react": "^14.3.1",
		"@testing-library/user-event": "^14.5.1",
		"@types/glob": "^8.1.0",
		"@types/js-cookie": "^3.0.6",
		"@types/lodash.throttle": "^4.1.9",
		"@types/node": "^20.3.1",
		"@types/react": "19.0.0",
		"@types/react-dom": "19.0.0",
		"@types/styled-components": "^5.1.26",
		"@vitejs/plugin-react": "^5.0.0",
		"@vitest/browser": "^3.2.4",
		"@vitest/coverage-v8": "3.2.4",
		"eslint-config-next": "15.5.2",
		"fx_utils": "workspace:*",
		"html-react-parser": "^5.1.7",
		"postcss": "^8.4.38",
