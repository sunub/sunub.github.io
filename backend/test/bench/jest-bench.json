{
	"moduleFileExtensions": ["js", "json", "ts"],
	"rootDir": "../../",
	"testRegex": ".bench.spec.ts$",
	"transform": {
		"^.+\\.(t|j)s$": "ts-jest"
	},
	"collectCoverageFrom": ["**/*.(t|j)s"],
	"coverageDirectory": "../coverage",
	"testEnvironment": "node",
	"moduleNameMapper": {
		"^src/(.*)$": "<rootDir>/src/$1"
	},
	"globals": {
		"ts-jest": {
			"tsconfig": "tsconfig.json"
		}
	}
}
