{
	"name": "backend",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"ensure-port-free": "sh ./scripts/ensure-port-free.sh",
		"format": "pnpm exec biome format --write",
		"prestart": "pnpm run ensure-port-free",
		"start": "nest start",
		"prestart:ci": "pnpm run ensure-port-free",
		"start:ci": "node ./scripts/start-ci.mjs",
		"prestart:dev": "pnpm run ensure-port-free",
		"start:dev": "nest start --watch",
		"prestart:debug": "pnpm run ensure-port-free",
		"start:debug": "nest start --debug --watch",
		"prestart:prod": "pnpm run ensure-port-free",
		"start:prod": "node dist/main",
		"lint": "pnpm exec biome lint",
		"lint:write": "pnpm exec biome check --write --unsafe",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:bench": "pnpm run test:bench:posts",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"test:bench:performance": "pnpm run test:bench:posts",
		"test:bench:posts": "node --expose-gc -r ts-node/register/transpile-only -r tsconfig-paths/register ./test/bench/run-posts-benchmark.ts",
		"bench:setup": "bash ./test/bench/generate-posts.sh",
		"bench:run": "pnpm run test:bench:posts"
	},
	"dependencies": {
		"@nestjs/common": "^10.0.0",
		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "^10.0.0",
		"@nestjs/mapped-types": "*",
		"@nestjs/platform-express": "^10.0.0",
		"@nestjs/throttler": "^6.5.0",
		"@sunub/contracts": "workspace:*",
		"@sunub/types": "workspace:*",
		"chokidar": "^5.0.0",
		"gray-matter": "^4.0.3",
		"reflect-metadata": "^0.2.0",
		"rxjs": "^7.8.1",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@nestjs/cli": "^10.0.0",
		"@nestjs/schematics": "^10.0.0",
		"@nestjs/testing": "^10.0.0",
		"@sunub/utils": "workspace:*",
		"@types/express": "^5.0.0",
		"@types/jest": "^29.5.2",
		"@types/node": "^20.3.1",
		"@types/supertest": "^6.0.0",
		"jest": "^29.5.0",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.1.0",
		"ts-loader": "^9.4.3",
		"ts-node": "^10.9.1",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.1.3"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"moduleNameMapper": {
			"^src/(.*)$": "<rootDir>/$1",
			"^@sunub/types$": "<rootDir>/../../packages/types/main.ts",
			"^@sunub/contracts$": "<rootDir>/../../packages/contracts/main.ts"
		},
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
