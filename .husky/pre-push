#!/usr/bin/env sh
set -eu

target_branch="refs/heads/sunub"
should_run_checks=0
zero_oid="0000000000000000000000000000000000000000"

while read -r local_ref local_oid remote_ref remote_oid; do
	if [ "$remote_ref" = "$target_branch" ] && [ "$local_oid" != "$zero_oid" ]; then
		should_run_checks=1
		break
	fi
done

if [ "$should_run_checks" -ne 1 ]; then
	printf '%s\n' "pre-push: skipping sunub branch checks"
	exit 0
fi

run_step() {
	step_name="$1"
	shift

	printf '\n%s\n' "==> $step_name"
	"$@"
}

printf '%s\n' "pre-push: push to sunub detected, running CI-equivalent checks"

run_step "Build shared packages" pnpm build:shared
run_step "Lint code" pnpm exec biome ci --reporter=github
run_step "Type check" pnpm -r exec tsc --noEmit
run_step "Backend unit tests" pnpm --filter backend run test
run_step "Frontend unit tests" pnpm --filter frontend run test:unit
run_step "Frontend E2E tests" env PORT=4008 FRONTEND_PORT=4004 NODE_ENV=test pnpm --filter frontend run test:e2e
run_step "Production build" env PORT=4008 EC2_PUBLIC_API_URL=http://localhost:4008 NEXT_PUBLIC_BASE_URL=http://localhost:3000 NEXT_PUBLIC_BACKEND_URL=http://localhost:4008 pnpm run build

printf '\n%s\n' "pre-push: all checks passed for sunub, continuing push"
